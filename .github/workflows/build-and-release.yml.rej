-      # репозитория, а Chaquopy ждёт их в android/app/src/main/python —
+      # app.py / rbxl_parser.py / index.html / icons.txt / icons/ живут в
+      # корне репозитория, а Chaquopy ждёт их в android/app/src/main/python —
       # синхронизируем перед сборкой, чтобы не дублировать файлы вручную.
       - name: Sync Python sources into the Android project
-        run: |
-          mkdir -p android/app/src/main/python
-          cp app.py rbxl_parser.py index.html icons.txt android/app/src/main/python/
-          if [ -d icons ]; then
-            mkdir -p android/app/src/main/python/icons
-            cp -r icons/. android/app/src/main/python/icons/
-          fi
+        run: bash scripts/sync-android-python.sh
 
       - name: Set up Android SDK
         uses: android-actions/setup-android@v3
@@ -53,13 +126,6 @@
         with:
           gradle-version: 8.7
 
-      # Версия растёт с каждым запуском CI: 1.0 -> 1.1 -> 1.2 ...
-      - name: Compute version
-        id: version
-        run: |
-          echo "code=${{ github.run_number }}" >> "$GITHUB_OUTPUT"
-          echo "name=1.${{ github.run_number }}" >> "$GITHUB_OUTPUT"
-
       # Опционально: если в секретах репозитория задан ANDROID_KEYSTORE_BASE64,
       # все сборки (debug и release) подписываются одним и тем же ключом —
       # тогда APK можно ставить поверх предыдущей версии без удаления.
@@ -73,8 +139,8 @@
 
       - name: Build debug APK
         env:
-          ANDROID_VERSION_CODE: ${{ steps.version.outputs.code }}
-          ANDROID_VERSION_NAME: ${{ steps.version.outputs.name }}
+          ANDROID_VERSION_CODE: ${{ needs.resolve-tag.outputs.version_code }}
+          ANDROID_VERSION_NAME: ${{ needs.resolve-tag.outputs.version_name }}
           ANDROID_KEYSTORE_PATH: ${{ secrets.ANDROID_KEYSTORE_BASE64 != '' && format('{0}/android/app/release.keystore', github.workspace) || '' }}
           ANDROID_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
           ANDROID_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
@@ -92,6 +158,71 @@
       - name: Publish GitHub release
         uses: softprops/action-gh-release@v2
         with:
-          tag_name: v${{ steps.version.outputs.name }}
-          name: v${{ steps.version.outputs.name }}
+          tag_name: ${{ needs.resolve-tag.outputs.tag }}
+          name: ${{ needs.resolve-tag.outputs.tag }}
+          # ВАЖНО: это должен быть единственный тип релиза, который НЕ
+          # помечен prerelease — так /releases/latest и
+          # releases/latest/download/app-debug.apk всегда указывают на
+          # релиз, где точно есть APK. Hot-update релизы ниже специально
+          # помечены prerelease: true, чтобы не перехватывать этот статус.
+          prerelease: false
           files: android/app/build/outputs/apk/debug/app-debug.apk
+
+  # ---------- Лёгкое OTA-обновление: только когда менялись "горячие" файлы ----------
+  # Никакой компиляции — просто публикуем изменившиеся Python/HTML/иконки как
+  # ассеты нового релиза. Приложение на устройстве само их подтянет
+  # (см. OtaUpdater.kt) без переустановки APK.
+  publish-hot-update:
+    needs: [detect-changes, resolve-tag]
+    if: needs.detect-changes.outputs.hot_only == 'true'
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Sync Python sources into the Android project
+        run: bash scripts/sync-android-python.sh
+
+      - name: Generate OTA manifest
+        run: bash scripts/generate-ota-manifest.sh "${{ needs.resolve-tag.outputs.version_name }}"
+
+      # Чтобы диагностировать "хэш вроде другой у файла, который не менялся"
+      # без логов с телефона — печатаем сами хэши прямо в описание релиза.
+      - name: Prepare per-file hash summary for release notes
+        id: ota-summary
+        run: |
+          {
+            echo "summary<<OTA_SUMMARY_EOF"
+            python3 -c "
+          import json
+          m = json.load(open('ota/version.json', encoding='utf-8'))
+          for name, h in sorted(m['files'].items()):
+              print(f'- \`{name}\`: \`{h}\`')
+            "
+                        echo "OTA_SUMMARY_EOF"
+          } >> "$GITHUB_OUTPUT"
+
+      - name: Publish hot-update release
+        uses: softprops/action-gh-release@v2
+        with:
+          tag_name: hot-${{ github.run_number }}
+          name: "RbxStudio — hot update ${{ needs.resolve-tag.outputs.version_name }}"
+          body: |
+            Только обновление Python/HTML/иконок (app.py, rbxl_parser.py,
+            index.html, icons.txt, icons/), без изменений в нативном
+            Android-коде. Полная пересборка APK для этого не запускалась.
+
+            **sha256 файлов в этом обновлении** (сравни с прошлым hot-релизом,
+            чтобы понять, что реально изменилось):
+            ${{ steps.ota-summary.outputs.summary }}
+          generate_release_notes: false
+          # КРИТИЧНО: не даём этому релизу стать "latest release" — иначе
+          # releases/latest/download/app-debug.apk начнёт указывать на
+          # релиз без APK. OtaUpdater.kt поэтому смотрит на /releases
+          # (полный список, включая prerelease), а не на /releases/latest.
+          prerelease: true
+          files: |
+            ota/*.py
+            ota/*.html
+            ota/*.txt
+            ota/*.json
+            ota/icons/*
