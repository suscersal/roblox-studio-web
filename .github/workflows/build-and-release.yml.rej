--- .github/workflows/build-and-release.yml	2026-08-15 09:38:13.040504429 +0000
+++ .github/workflows/build-and-release.yml	2026-08-15 09:40:58.036500655 +0000
@@ -9,6 +9,8 @@
       - 'rbxl_parser.py'
       - 'index.html'
       - 'icons.txt'
+      - 'icons/**'
+      - 'scripts/**'
       - '.github/workflows/build-and-release.yml'
   workflow_dispatch: {}
 
@@ -16,7 +18,84 @@
   contents: write
 
 jobs:
+  # Определяем, какие файлы поменялись в этом пуше: если это ТОЛЬКО
+  # "горячие" файлы (чистый Python + index.html + иконки — не требуют
+  # компиляции), то полную сборку APK не запускаем вообще, а вместо неё
+  # публикуем лёгкое OTA-обновление (см. publish-hot-update). Если
+  # поменялось что-то ещё (Kotlin, gradle, манифест, воркфлоу) — собираем
+  # APK как обычно.
+  detect-changes:
+    runs-on: ubuntu-latest
+    outputs:
+      hot_only: ${{ steps.filter.outputs.hot_only }}
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Classify changed files
+        id: filter
+        run: |
+          set -euo pipefail
+
+          # Для ручного запуска или самого первого пуша сравнивать не с чем —
+          # считаем это "не только горячими" файлами, т.е. собираем всё.
+          if [[ "${{ github.event_name }}" == "workflow_dispatch" ]] || \
+             [[ "${{ github.event.before }}" == "0000000000000000000000000000000000000000" ]] || \
+             [[ -z "${{ github.event.before }}" ]]; then
+            echo "hot_only=false" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+
+          CHANGED=$(git diff --name-only "${{ github.event.before }}" "${{ github.sha }}")
+          echo "Changed files:"
+          echo "$CHANGED"
+
+          # Файлы, которые НИКОГДА не требуют полной сборки (документация, README и т.п.)
+          IGNORE_REGEX='^(README\.md|\.github/.*\.md|docs/.*|\.gitignore|LICENSE)$'
+
+          # "Горячие" пути — то, что попадает в scripts/sync-android-python.sh
+          # и не требует пересборки нативного кода.
+          HOT_REGEX='^(app\.py|rbxl_parser\.py|index\.html|icons\.txt|icons/.*)$'
+
+          # Убираем из списка изменений файлы, которые вообще не влияют на сборку
+          NON_IGNORED=$(echo "$CHANGED" | grep -Ev "$IGNORE_REGEX" || true)
+
+          if [[ -z "$NON_IGNORED" ]]; then
+            # Изменились ТОЛЬКО игнорируемые файлы (README и т.п.) —
+            # не запускаем вообще ничего, даже hot-update.
+            echo "hot_only=true" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+
+          NON_HOT=$(echo "$NON_IGNORED" | grep -Ev "$HOT_REGEX" || true)
+
+          if [[ -z "$NON_HOT" ]]; then
+            echo "hot_only=true" >> "$GITHUB_OUTPUT"
+          else
+            echo "hot_only=false" >> "$GITHUB_OUTPUT"
+          fi
+
+  # Единая точка, где вычисляется тег релиза и версия — чтобы во всех
+  # job'ах (build/hot-update) они были одинаковыми.
+  resolve-tag:
+    needs: detect-changes
+    runs-on: ubuntu-latest
+    outputs:
+      tag: ${{ steps.version.outputs.tag }}
+      version_code: ${{ steps.version.outputs.code }}
+      version_name: ${{ steps.version.outputs.name }}
+    steps:
+      - name: Compute version
+        id: version
+        run: |
+          echo "tag=v1.${{ github.run_number }}" >> "$GITHUB_OUTPUT"
+          echo "code=${{ github.run_number }}" >> "$GITHUB_OUTPUT"
+          echo "name=1.${{ github.run_number }}" >> "$GITHUB_OUTPUT"
+
   build:
+    needs: [detect-changes, resolve-tag]
+    if: needs.detect-changes.outputs.hot_only != 'true'
     runs-on: ubuntu-latest
     steps:
       - name: Checkout
@@ -28,17 +107,11 @@
