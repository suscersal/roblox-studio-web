<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Нужно даже для соединений на 127.0.0.1 — Android требует INTERNET
         для любого сокета, включая loopback. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Для чтения выбранных пользователем .rbxl-файлов через системный
         пикер (SAF) разрешение не требуется. Это — только если решите
         добавить обход произвольных папок как в /api/browse. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
    android:allowBackup="true"
    android:icon="@mipmap/ic_launcher"
    android:label="Roblox Studio Web"
    android:networkSecurityConfig="@xml/network_security_config"
    android:usesCleartextTraffic="true"
    android:theme="@style/Theme.RSW">
        <!-- android:icon не задан, чтобы не тащить бинарные PNG в шаблон —
             добавьте свой @mipmap/ic_launcher и пропишите здесь при желании. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- «Открыть с помощью» для .rbxl из файлового менеджера. pathPattern в Android не умеет «любое число точек»,
                 поэтому шаблонов несколько (имя с точками внутри). mimeType */* — у менеджеров он почти всегда разный. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.rbxl" />
                <data android:pathPattern=".*\\..*\\.rbxl" />
                <data android:pathPattern=".*\\..*\\..*\\.rbxl" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.rbxl" />
            </intent-filter>
        </activity>

        <!-- Отдельный экран для входа в аккаунт Roblox через обычную
             веб-форму (WebView) — см. RobloxLoginActivity.kt. Не exported:
             запускается только изнутри приложения. -->
        <activity
            android:name=".RobloxLoginActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
