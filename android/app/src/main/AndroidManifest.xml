<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed even for connections to 127.0.0.1 — Android requires INTERNET
         for any socket, including loopback. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reading .rbxl files chosen by the user through the system
         picker (SAF) needs no permission. This is only if you decide to
         add browsing of arbitrary folders as in /api/browse. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
    android:allowBackup="true"
    android:icon="@mipmap/ic_launcher"
    android:label="Roblox Studio Web"
    android:networkSecurityConfig="@xml/network_security_config"
    android:usesCleartextTraffic="true"
    android:theme="@style/Theme.RSW">
        <!-- android:icon isn't set, so as not to drag binary PNGs into the template —
             add your own @mipmap/ic_launcher and set it here if you wish. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- «Open with» for .rbxl from a file manager. Android's pathPattern can't do «any number of dots»,
                 so there are several patterns (a name with dots inside). mimeType */* — file managers almost always differ in it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.rbxl" />
                <data android:pathPattern=".*\\..*\\.rbxl" />
                <data android:pathPattern=".*\\..*\\..*\\.rbxl" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.rbxl" />
            </intent-filter>

            <!-- A fallback without a path check: Telegram and others open unknown files as text/plain, while MIUI/HyperOS
                 «Explorer» uses application/octet-stream, and a content:// Uri's path doesn't always end with .rbxl.
                 Side effect: the app is offered for other text/unrecognized files too. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-binary" />
            </intent-filter>
        </activity>

        <!-- A separate screen for signing in to a Roblox account through an ordinary
             web form (WebView) — see RobloxLoginActivity.kt. Not exported:
             it is launched only from inside the app. -->
        <activity
            android:name=".RobloxLoginActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
